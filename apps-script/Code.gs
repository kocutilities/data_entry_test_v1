function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) {
      return json({ result: 'error', message: 'Empty request' });
    }

    var payload = JSON.parse(e.postData.contents);
    if (!payload || typeof payload !== 'object') {
      return json({ result: 'error', message: 'Malformed request' });
    }

    /* Only these three do anything. Anything else used to fall through to
       the write path - a request with no type at all would have written. */
    if (payload.type === 'status')       return handleStatus(payload);
    if (payload.type === 'history')      return handleHistory(payload);
    if (payload.type === 'load-reading') return handleSubmit(payload);
    return json({ result: 'error', message: 'Unknown request type' });

  } catch (err) {
    return json({ result: 'error', message: String(err) });
  }
}


/** Health check: opening the /exec URL in a browser should show this. */
function doGet() {
  return json({
    result: 'success',
    service: 'KOC Data Center load reading',
    sheet: SHEET_NAME,
    rows: Math.max(0, getSheet().getLastRow() - 1)
  });
}


/* =========================================================================
   status - what is already recorded for a given date
   ========================================================================= */

function handleStatus(payload) {
  var date = String(payload.date || '').trim();
  if (!date) return json({ result: 'error', message: 'No date given' });

  var index = readIndex(date);
  var recorded = {};

  for (var key in index) {
    var hit = index[key];
    recorded[key] = { r: hit.r, y: hit.y, b: hit.b, row: hit.row };
  }

  LAST_SCAN_DATES_.sort();
  LAST_SCAN_DATES_.reverse();

  return json({ result: 'success', date: date, recorded: recorded,
                latest: LAST_SCAN_LATEST_,
                dates: LAST_SCAN_DATES_.slice(0, 120) });
}


/* =========================================================================
   history - how the system has actually loaded over a period

   A single day's reading can miss the annual peak entirely, so an
   additional-load study has to be judged against the worst condition
   actually recorded, not against whatever today happened to be.

   Returns, for a date range:
     stats   per feeder - max, min, mean, median, count, and the DATE the
             maximum was recorded, so a peak can be traced back
     demand  the site demand, computed as the COINCIDENT sum of the two
             incomers on the same date. Taking max(A) + max(B) across
             different dates would invent a peak that never happened.
     cover   what the range really holds: first and last date found and
             how many distinct reading dates. The client needs this to say
             whether the requested period is actually covered.
   ========================================================================= */

function handleHistory(payload) {
  var from = normaliseDate(payload.from || '');
  var to = normaliseDate(payload.to || '');
  if (!from || !to) return json({ result: 'error', message: 'from and to dates are required' });

  var sheet = getSheet();
  var last = sheet.getLastRow();
  if (last < 2) {
    return json({ result: 'success', from: from, to: to,
                  cover: { dates: 0, first: null, last: null, rows: 0 },
                  stats: {}, demand: null });
  }

  var width = C_B - C_DATE + 1;
  var data = sheet.getRange(2, C_DATE, last - 1, width).getValues();

  var vals = {};          /* key -> [ {v, d} ] */
  var perDate = {};       /* date -> { 'Incomer A': v, 'Incomer B': v } */
  var seenDates = {};
  var rows = 0, first = null, lastSeen = null;

  for (var i = 0; i < data.length; i++) {
    var row = data[i];
    var d = normaliseDate(row[0]);
    if (!d || d < from || d > to) continue;

    rows++;
    seenDates[d] = true;
    if (!first || d < first) first = d;
    if (!lastSeen || d > lastSeen) lastSeen = d;

    var key = rowKey(row[C_CATEGORY - C_DATE],
                     row[C_EQUIPMENT - C_DATE],
                     row[C_CIRCUIT - C_DATE]);

    var r = Number(row[C_R - C_DATE]) || 0;
    var y = Number(row[C_Y - C_DATE]) || 0;
    var b = Number(row[C_B - C_DATE]) || 0;
    var v = Math.max(r, y, b);

    var ph = (v === r) ? 'R' : (v === y) ? 'Y' : 'B';
    if (!vals[key]) vals[key] = [];
    vals[key].push({ v: v, d: d, ph: ph });

    var eq = String(row[C_EQUIPMENT - C_DATE]).trim();
    if (eq === 'Incomer A' || eq === 'Incomer B') {
      if (!perDate[d]) perDate[d] = {};
      /* keep each phase separately: the transformer carries the sum of the
         two incomers PHASE BY PHASE, and summing the two maxima instead
         would invent a current that no conductor ever saw */
      var cur = perDate[d][eq] || { r: 0, y: 0, b: 0 };
      perDate[d][eq] = { r: Math.max(cur.r, r), y: Math.max(cur.y, y), b: Math.max(cur.b, b) };
    }
  }

  /* per feeder statistics */
  var stats = {};
  for (var k in vals) {
    var arr = vals[k];
    var nums = arr.map(function (x) { return x.v; }).sort(function (a, b) { return a - b; });
    var sum = 0;
    for (var j = 0; j < nums.length; j++) sum += nums[j];
    var top = arr[0];
    for (var m = 1; m < arr.length; m++) if (arr[m].v > top.v) top = arr[m];

    stats[k] = {
      n: nums.length,
      min: nums[0],
      max: nums[nums.length - 1],
      avg: sum / nums.length,
      med: median(nums),
      p95: percentile(nums, 0.95),
      maxDate: top.d,
      maxPhase: top.ph
    };
  }

  /* coincident site demand, per date */
  var demand = null;
  var dd = [];
  for (var dt in perDate) {
    var e = perDate[dt];
    /* only count a date where BOTH incomers were read, otherwise the
       total is not the site demand */
    if (e['Incomer A'] === undefined || e['Incomer B'] === undefined) continue;
    var a = e['Incomer A'], b2 = e['Incomer B'];
    var sr = a.r + b2.r, sy = a.y + b2.y, sb = a.b + b2.b;
    var sv = Math.max(sr, sy, sb);
    dd.push({ d: dt, v: sv, ph: (sv === sr) ? 'R' : (sv === sy) ? 'Y' : 'B',
              a: Math.max(a.r, a.y, a.b), b: Math.max(b2.r, b2.y, b2.b) });
  }
  if (dd.length) {
    var dv = dd.map(function (x) { return x.v; }).sort(function (a, b) { return a - b; });
    var dsum = 0;
    for (var q = 0; q < dv.length; q++) dsum += dv[q];
    var dtop = dd[0];
    for (var w = 1; w < dd.length; w++) if (dd[w].v > dtop.v) dtop = dd[w];
    demand = {
      n: dv.length, min: dv[0], max: dv[dv.length - 1],
      avg: dsum / dv.length, med: median(dv), p95: percentile(dv, 0.95),
      maxDate: dtop.d,
      maxPhase: dtop.ph,
      aAtMax: dtop.a,
      bAtMax: dtop.b,
      bothIncomersDates: dv.length
    };
  }

  var nDates = 0;
  for (var s2 in seenDates) nDates++;

  return json({
    result: 'success', from: from, to: to,
    cover: { dates: nDates, first: first, last: lastSeen, rows: rows },
    stats: stats, demand: demand
  });
}


function median(sorted) {
  if (!sorted.length) return null;
  var mid = Math.floor(sorted.length / 2);
  return sorted.length % 2 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
}


function percentile(sorted, p) {
  if (!sorted.length) return null;
  var idx = Math.ceil(p * sorted.length) - 1;
  if (idx < 0) idx = 0;
  if (idx >= sorted.length) idx = sorted.length - 1;
  return sorted[idx];
}


/* =========================================================================
   submit
   ========================================================================= */

function handleSubmit(payload) {
  var rawMeta = (payload.meta && typeof payload.meta === 'object') ? payload.meta : {};
  var rows = Array.isArray(payload.rows) ? payload.rows : [];

  if (!rows.length) return json({ result: 'error', message: 'No readings in request' });
  if (rows.length > LIMITS.MAX_ROWS) {
    return json({ result: 'error', message: 'Too many rows in one request (' + rows.length +
                  '; the limit is ' + LIMITS.MAX_ROWS + ')' });
  }

  /* The header applies to every row, so a bad one refuses the whole request
     rather than writing rows under a date nobody meant. */
  var date = checkDate(rawMeta.date);
  if (date.error) return json({ result: 'error', message: date.error });
  var time = checkTime(rawMeta.time);
  if (time.error) return json({ result: 'error', message: time.error });

  var meta = {
    date:    date.value,
    time:    time.value,
    takenBy: safeText(rawMeta.takenBy),
    site:    safeText(rawMeta.site),
    remarks: safeText(rawMeta.remarks)
  };

  // A lock keeps two phones submitting at once from interleaving rows or
  // both getting past the duplicate check.
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000);
  } catch (err) {
    return json({ result: 'error', message: 'Sheet busy, try again' });
  }

  try {
    var sheet = getSheet();
    var index = readIndex(meta.date);
    var stamp = new Date();

    var saved = [];        // keys written as new rows
    var replaced = [];     // keys that overwrote an existing row
    var duplicates = [];   // keys refused
    var rejected = [];     // keys refused as invalid, with the reason
    var appendRows = [];   // values queued for one setValues call
    var appendKeys = [];
    var seen = {};         // one row per key per request

    rows.forEach(function (r) {
      if (!r || typeof r !== 'object') {
        rejected.push({ key: '', reason: 'Not a reading' });
        return;
      }
      var key = rowKey(r.category, r.equipment, r.circuit);

      /* A row is rejected on its own, not the whole request, so a stale
         allowlist - config.js edited, this file not regenerated - refuses
         the one new way and still saves the rest of the round. */
      var spec = ALLOWED[key];
      if (!spec) {
        rejected.push({ key: key, reason: 'Not a feeder or PDU way this sheet knows - if it ' +
                        'was just added to config.js, regenerate Code.gs and redeploy' });
        return;
      }
      if (seen[key]) {
        rejected.push({ key: key, reason: 'Sent twice in one request' });
        return;
      }
      seen[key] = true;

      var cur = checkCurrents(r);
      if (cur.error) {
        rejected.push({ key: key, reason: cur.error });
        return;
      }

      var values = buildRow(stamp, meta, key, spec, cur);
      var existing = index[key];

      if (existing) {
        if (!r.replace) {
          duplicates.push({ key: key, r: existing.r, y: existing.y, b: existing.b, row: existing.row });
          return;
        }
        /* Copy what is there before overwriting it. Without this a false
           reading written over a real one would leave no trace - so if the
           copy cannot be made, the overwrite does not happen either. */
        try {
          audit(sheet, existing.row, values, stamp);
        } catch (err) {
          rejected.push({ key: key, reason: 'Could not keep a copy of the existing reading, ' +
                          'so it was left unchanged (' + String(err) + ')' });
          return;
        }
        sheet.getRange(existing.row, 1, 1, HEADERS.length).setValues([values]);
        replaced.push({ key: key, row: existing.row });
        return;
      }

      appendRows.push(values);
      appendKeys.push(key);
    });

    if (appendRows.length) {
      var first = sheet.getLastRow() + 1;
      sheet.getRange(first, 1, appendRows.length, HEADERS.length).setValues(appendRows);
      appendKeys.forEach(function (key, i) {
        saved.push({ key: key, row: first + i });
      });
    }

    return json({
      result: 'success',
      saved: saved,
      replaced: replaced,
      duplicates: duplicates,
      rejected: rejected
    });

  } catch (err) {
    return json({ result: 'error', message: String(err) });
  } finally {
    lock.releaseLock();
  }
}


/* Everything about the equipment comes from the allowlist and everything
   derived is recomputed here. The request supplies only which row it is and
   the three currents - it cannot set a rack name, a rating or a "% loaded". */
function buildRow(stamp, meta, key, spec, cur) {
  var parts = key.split('|');
  var rack = spec[0], rated = spec[1];

  var present = [cur.r, cur.y, cur.b].filter(function (v) { return v !== ''; });
  var max = present.length ? Math.max.apply(null, present) : '';
  var pct = (max !== '' && rated) ? Math.round(max / rated * 1000) / 10 : '';

  return [
    stamp,
    meta.date,
    meta.time,
    meta.takenBy,
    meta.site,
    parts[0],
    parts[1],
    parts[2],
    rack,
    rated === '' ? '' : rated,
    cur.r,
    cur.y,
    cur.b,
    max,
    pct,
    nemaUnbalance(cur.r, cur.y, cur.b),
    meta.remarks
  ];
}


/* =========================================================================
   sheet access
   ========================================================================= */

/**
 * Everything already recorded on one date, keyed by category|equipment|circuit.
 * Only the columns needed for the lookup are read, so this stays cheap as the
 * sheet grows.
 */
/* The newest date seen by the last readIndex pass. It comes free - that pass
   already looks at every date - and saves reading the column a second time
   just to answer "what is the most recent day on the sheet". */
var LAST_SCAN_LATEST_ = null;

/* Every distinct date seen by that same pass, newest first. Also free - the
   page needs it to offer a list of days to look back at, and asking for it
   separately would be another round trip for something already in hand. */
var LAST_SCAN_DATES_ = [];

function readIndex(date) {
  var sheet = getSheet();
  var last = sheet.getLastRow();
  var index = {};

  /* Cleared before the early return, not after it. Leaving it set would let
     an empty sheet report the previous call's answer - which in Apps Script
     only bites when one instance serves two requests, but is wrong either
     way and is exactly what the test caught. */
  LAST_SCAN_LATEST_ = null;
  LAST_SCAN_DATES_ = [];

  if (last < 2) return index;

  var width = C_B - C_DATE + 1;                       // Date .. B
  var data = sheet.getRange(2, C_DATE, last - 1, width).getValues();
  var want = normaliseDate(date);
  var seenDates = {};

  for (var i = 0; i < data.length; i++) {
    var row = data[i];
    var d = normaliseDate(row[0]);
    if (d) {
      if (LAST_SCAN_LATEST_ === null || d > LAST_SCAN_LATEST_) LAST_SCAN_LATEST_ = d;
      if (seenDates[d] === undefined) { seenDates[d] = true; LAST_SCAN_DATES_.push(d); }
    }
    if (d !== want) continue;

    var key = rowKey(row[C_CATEGORY - C_DATE],
                     row[C_EQUIPMENT - C_DATE],
                     row[C_CIRCUIT - C_DATE]);

    // Last write wins, matching what a replace leaves behind.
    index[key] = {
      row: i + 2,
      r: row[C_R - C_DATE],
      y: row[C_Y - C_DATE],
      b: row[C_B - C_DATE]
    };
  }

  return index;
}


function getSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SHEET_NAME);

  if (!sheet) {
    sheet = ss.insertSheet(SHEET_NAME);
  }

  if (sheet.getLastRow() === 0) {
    sheet.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]);
    sheet.getRange(1, 1, 1, HEADERS.length).setFontWeight('bold');
    sheet.setFrozenRows(1);
  }

  return sheet;
}


/* =========================================================================
   helpers
   ========================================================================= */


/* =========================================================================
   Checking what a request sends. Nothing here trusts the page: the URL is
   public, so these assume the request may come from anywhere.
   ========================================================================= */

/* A reading date: yyyy-mm-dd, a real calendar day, not before FIRST_YEAR and
   not more than DAYS_AHEAD into the future. */
function checkDate(v) {
  var s = String(v === null || v === undefined ? '' : v).trim();
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
  if (!m) return { error: 'Reading date must be yyyy-mm-dd' };

  var y = +m[1], mo = +m[2], d = +m[3];
  var dt = new Date(Date.UTC(y, mo - 1, d));
  if (dt.getUTCFullYear() !== y || dt.getUTCMonth() !== mo - 1 || dt.getUTCDate() !== d) {
    return { error: 'Reading date ' + s + ' is not a real date' };
  }
  if (y < LIMITS.FIRST_YEAR) return { error: 'Reading date ' + s + ' is too early' };

  var limit = Utilities.formatDate(new Date(Date.now() + LIMITS.DAYS_AHEAD * 86400000),
                                   sheetTz_(), 'yyyy-MM-dd');
  if (s > limit) return { error: 'Reading date ' + s + ' is in the future' };

  return { value: s };
}

/* Time of reading: blank, or hh:mm on a 24-hour clock. */
function checkTime(v) {
  var s = String(v === null || v === undefined ? '' : v).trim();
  if (s === '') return { value: '' };
  var m = /^([01]\d|2[0-3]):([0-5]\d)$/.exec(s);
  if (!m) return { error: 'Time must be hh:mm' };
  return { value: s };
}

/* The three phase currents. Each is blank or a number from 0 to MAX_AMPS,
   and at least one must be present. Not checked against the feeder's rating
   on purpose - see LIMITS. */
function checkCurrents(r) {
  var out = {};
  var any = false;
  var names = { r: 'R', y: 'Y', b: 'B' };
  for (var ph in names) {
    var v = r[ph];
    if (v === '' || v === null || v === undefined) { out[ph] = ''; continue; }
    var n = (typeof v === 'number') ? v : Number(String(v).trim());
    if (typeof v !== 'number' && !/^-?\d+(\.\d+)?$/.test(String(v).trim())) {
      return { error: names[ph] + ' phase is not a number' };
    }
    if (!isFinite(n)) return { error: names[ph] + ' phase is not a number' };
    if (n < 0)        return { error: names[ph] + ' phase is negative' };
    if (n > LIMITS.MAX_AMPS) {
      return { error: names[ph] + ' phase ' + n + ' A is beyond anything on this site' };
    }
    out[ph] = n;
    any = true;
  }
  if (!any) return { error: 'No current entered' };
  return out;
}

/* Free text: trimmed, stripped of control characters, capped, and never
   allowed to begin a formula.

   Sheets turns a value starting with = + - or @ into a formula, and a formula
   such as IMPORTXML or HYPERLINK can send the sheet's contents to another
   server whenever anyone opens it. A leading apostrophe makes Sheets store it
   as plain text; it is not shown in the cell. */
function safeText(v) {
  var s = String(v === null || v === undefined ? '' : v);
  s = s.replace(/[\u0000-\u001F\u007F]/g, ' ').replace(/\s+/g, ' ').trim();
  if (s.length > LIMITS.MAX_TEXT) s = s.slice(0, LIMITS.MAX_TEXT);
  if (/^[=+\-@]/.test(s)) s = "'" + s;
  return s;
}

/* Greatest deviation from the mean, as a percentage of it - the same NEMA
   form load-reading.js shows, to one decimal. Blank unless all three phases
   are present, which is how single-phase ways come out blank. */
function nemaUnbalance(r, y, b) {
  if (r === '' || y === '' || b === '') return '';
  var avg = (r + y + b) / 3;
  if (avg <= 0) return '';
  var dev = Math.max(Math.abs(r - avg), Math.abs(y - avg), Math.abs(b - avg));
  return Math.round(dev / avg * 1000) / 10;
}

/* Before a row is overwritten, keep both versions side by side on the Audit
   tab: what was there, then what replaced it. Throws if it cannot, and the
   caller then leaves the reading unchanged. */
function audit(sheet, rowNum, newValues, stamp) {
  var old = sheet.getRange(rowNum, 1, 1, HEADERS.length).getValues()[0];
  var a = getAuditSheet();
  var first = a.getLastRow() + 1;
  a.getRange(first, 1, 2, HEADERS.length + 3).setValues([
    [stamp, rowNum, 'before'].concat(old),
    [stamp, rowNum, 'after'].concat(newValues)
  ]);
}

function getAuditSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var a = ss.getSheetByName(AUDIT_SHEET);
  if (!a) {
    a = ss.insertSheet(AUDIT_SHEET);
    a.getRange(1, 1, 1, HEADERS.length + 3)
     .setValues([['Audited at', 'Sheet row', 'Version'].concat(HEADERS)]);
    a.setFrozenRows(1);
  }
  return a;
}

function rowKey(category, equipment, circuit) {
  return [String(category === undefined || category === null ? '' : category).trim(),
          String(equipment === undefined || equipment === null ? '' : equipment).trim(),
          String(circuit   === undefined || circuit   === null ? '' : circuit).trim()
         ].join('|');
}


/**
 * Sheets may store the date column as text or coerce it to a Date, depending
 * on the cell format. Reduce either to yyyy-MM-dd so the comparison holds.
 */
/* Both of the calls this used to make per row - getSpreadsheetTimeZone and
   formatDate - cross the Apps Script service bridge, which costs milliseconds
   each. On a sheet of 400 rows that was over 800 bridge calls for a single
   status check, and it was most of the ten seconds the page spent waiting.

   The timezone is fetched once. The formatted date is memoised on the
   timestamp, so a sheet holding five distinct dates formats five times
   instead of once per row. Both caches live only for the duration of one
   request, which is all Apps Script gives us anyway. */
var TZ_ = null;
var DATE_MEMO_ = {};

function sheetTz_() {
  if (TZ_ === null) TZ_ = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone();
  return TZ_;
}

function normaliseDate(v) {
  if (v instanceof Date) {
    var t = v.getTime();
    var hit = DATE_MEMO_[t];
    if (hit === undefined) {
      hit = Utilities.formatDate(v, sheetTz_(), 'yyyy-MM-dd');
      DATE_MEMO_[t] = hit;
    }
    return hit;
  }
  return String(v === null || v === undefined ? '' : v).trim().slice(0, 10);
}


/** Keep genuine zeros, but write '' rather than 0 for a missing reading. */
function blankOrNum(v) {
  if (v === '' || v === null || v === undefined) return '';
  var n = Number(v);
  return isNaN(n) ? '' : n;
}


function json(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}
