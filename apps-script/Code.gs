/**
 * KOC Data Center - Load Reading
 * Google Apps Script web app behind load-reading.html.
 *
 * Readings are submitted a feeder at a time, because the equipment sits in
 * different areas and is read at different times. Each feeder becomes one row.
 *
 * Two request types, both POST:
 *
 *   { type: 'status', date: '2026-09-06' }
 *       -> what is already recorded for that date, so the page can show
 *          "Already Recorded" instead of letting someone enter it twice.
 *
 *   { type: 'load-reading', meta: {...}, rows: [ {...}, ... ] }
 *       -> save. Any row already present for that date is refused as a
 *          duplicate unless it carries replace:true, which overwrites the
 *          existing row in place rather than appending a correction.
 *
 * -------------------------------------------------------------------------
 * SETUP
 *   1. Open the target Google Sheet, Extensions > Apps Script.
 *   2. Paste this file over Code.gs and save.
 *   3. Deploy > New deployment > type "Web app".
 *        Execute as:        Me
 *        Who has access:    Anyone
 *      "Anyone" is required - the page posts without a Google sign-in.
 *   4. Copy the /exec URL into DC_CONFIG.endpoint in assets/js/config.js.
 *
 * THE URL IS PUBLIC
 *   It is built into a page served from a public repository, and the
 *   deployment must accept "Anyone", so this script has to assume a stranger
 *   can post to it. It therefore trusts nothing in a request:
 *
 *     - only the three request types above do anything;
 *     - a row is written only if its key is on ALLOWED, the list of real
 *       feeders and PDU ways generated from config.js;
 *     - the rack and the rating are written from ALLOWED, never from the
 *       request, and Max A, % loaded and Unbalance % are recomputed here;
 *     - currents must be numbers between 0 and MAX_AMPS;
 *     - free text is length-capped and cannot start a formula, so nothing a
 *       request sends can make the sheet fetch or run anything;
 *     - every overwrite is copied to the Audit tab first, with what it
 *       replaced, so a false reading written over a real one is visible and
 *       reversible.
 *
 *   What this does NOT stop: someone holding the URL writing a plausible
 *   false reading for a real feeder. Only a per-person token checked here
 *   would stop that. The Audit tab is what makes it detectable meanwhile.
 *
 * AFTER EDITING config.js
 *   If a feeder or PDU way was added, removed or renamed, run
 *       node apps-script/build_allowlist.js
 *   to regenerate ALLOWED, then paste this file and deploy a New version.
 *   Until then the server refuses that row by name - it does not guess.
 *
 * AFTER ANY EDIT TO THIS FILE
 *   Deploy > Manage deployments > edit > Version: **New version** > Deploy.
 *   Saving alone does not update the published web app: the old code keeps
 *   running and the change fails silently.
 * -------------------------------------------------------------------------
 */

/** Tab the readings are written to. Created automatically if absent. */
var SHEET_NAME = 'Load Readings';

/** Column order. The header row is written once, on first use. */
var HEADERS = [
  'Timestamp', 'Date', 'Time', 'Taken by', 'Site',
  'Category', 'Equipment', 'Circuit', 'Rack', 'Rated A',
  'R', 'Y', 'B', 'Max A', '% loaded', 'Unbalance %', 'Remarks'
];

/* Column positions, 1-based, so the offsets below stay readable. */
var C_DATE = 2, C_CATEGORY = 6, C_EQUIPMENT = 7, C_CIRCUIT = 8;
var C_R = 11, C_Y = 12, C_B = 13;

/** Where overwritten rows are copied before they are replaced. */
var AUDIT_SHEET = 'Audit';

/* What a request may contain. Generous enough never to refuse a real round -
   a full round is about 300 rows, the largest device is a 2133 A incomer and
   the busbar is 3200 A - and tight enough to refuse junk.

   MAX_AMPS is deliberately NOT tied to each feeder's rating. A reading above
   rating is an overload, which is exactly the reading this sheet exists to
   capture; refusing it would hide the one finding that matters. The ceiling
   only rejects numbers no clamp meter on this site could produce. */
var LIMITS = {
  MAX_ROWS:   700,
  MAX_AMPS:   5000,
  MAX_TEXT:   120,
  FIRST_YEAR: 2015,        /* the sheet's earliest reading is 2023 */
  DAYS_AHEAD: 2            /* a reading cannot be dated far in the future */
};

